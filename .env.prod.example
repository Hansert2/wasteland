# Production environment for docker-compose.prod.yml.
#
#   cp .env.prod.example .env.prod
#
# .env.prod is gitignored along with .env. Nothing in here belongs in the repo.

# Generate one and never reuse it: openssl rand -base64 32
POSTGRES_PASSWORD=

# Defaults are fine; here so the connection string in the compose file has something
# to interpolate if you change them.
POSTGRES_USER=wasteland
POSTGRES_DB=wasteland

# Where the app is published on the host. Loopback by default, which is right when a
# tunnel or a reverse proxy on the same box is how you get in.
APP_PORT=3000

# Widen the binding only if something on another host has to reach it: 0.0.0.0 for
# every interface, or a single address for one. Not a way to browse it directly —
# the session cookie is Secure in production, so a browser on plain http:// to
# anything but localhost will not keep it, and the login will never stick.
# APP_BIND=0.0.0.0

# The number of proxies in front of the process, and it must be the truth. One tunnel
# or one reverse proxy is 1.
#
# If you widen APP_BIND and put nothing in front, DELETE this line. Express takes the
# caller from X-Forwarded-For when it is set, and that header is caller-supplied:
# trusting a hop that is not there lets anyone claim any address and walk past the
# credential rate limiter.
TRUST_PROXY=1

# Only needed with `--profile tunnel`. Leave it blank otherwise — the stack starts
# fine without it. From the Cloudflare Zero Trust dashboard: Networks → Tunnels →
# create → copy the connector token.
TUNNEL_TOKEN=
