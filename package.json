{
  "name": "project-wasteland",
  "version": "0.0.0",
  "private": true,
  "description": "Post-apocalyptic browser text RPG",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "npm run db:up && node --env-file=.env src/server.js",
    "dev": "npm run db:up && node --env-file=.env --watch src/server.js",
    "test": "node --test \"test/unit/**/*.test.js\"",
    "test:db": "npm run db:up && node --env-file=.env --test \"test/db/**/*.test.js\"",
    "test:all": "npm test && npm run test:db",
    "migrate": "npm run db:up && node --env-file=.env src/db/migrate.js",
    "db:up": "wsl -d Debian --cd \"%CD%\" -- docker compose up -d",
    "db:down": "wsl -d Debian --cd \"%CD%\" -- docker compose down",
    "db:logs": "wsl -d Debian --cd \"%CD%\" -- docker compose logs -f db",
    "db:psql": "wsl -d Debian --cd \"%CD%\" -- docker compose exec db psql -U wasteland -d wasteland"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.23.0"
  }
}
